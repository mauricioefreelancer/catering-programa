# ==== Backend Catering ERP · Plantilla variables entorno ====
# Copiar como .env y rellenar tus propios valores (NUNCA subir .env a GitHub)

# ===== Conexión PostgreSQL =====
# Desarrollo local (DIRECT_URL = misma URL)
DATABASE_URL="postgresql://postgres:TU_PASSWORD_LOCAL@localhost:5432/catering_db?schema=public"
DIRECT_URL="postgresql://postgres:TU_PASSWORD_LOCAL@localhost:5432/catering_db?schema=public"

# Producción Render PostgreSQL:
# 1) Crea servicio PostgreSQL en Render:  name=catering-db
# 2) Copia Internal URL (pooled) a DATABASE_URL. Añadir ?schema=public&pgbouncer=true
# 3) Copia Internal URL (direct)   a DIRECT_URL.   Añadir ?schema=public
# Ejemplo Render:
# DATABASE_URL="postgresql://catering_db_user:PASSWORD@dpg-crnXXXXXX-pooling.frankfurt-postgres.render.com/catering_db?schema=public&pgbouncer=true"
# DIRECT_URL="postgresql://catering_db_user:PASSWORD@dpg-crnXXXXXX.frankfurt-postgres.render.com/catering_db?schema=public"

# ===== JWT Autenticación =====
# Generar clave segura: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CAMBIA_ESTA_CLAVE_SEGURA_EN_PRODUCCION_64CHARS"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ===== Servidor =====
PORT=3000
NODE_ENV=development

# ===== CORS (permitir tu frontend) =====
# Producción Netlify: CORS_ORIGIN="https://TU-SITIO.netlify.app"
# Desarrollo local:
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# ===== Negocio =====
TARIFA_PROMEDIO_DEFAULT=3500
UMBRAL_MARGEN=30
BCRYPT_ROUNDS=12
